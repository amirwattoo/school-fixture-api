{
  "name": "@school-fixture/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "lint": "eslint src --ext .ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --import ./tests/tsx-windows-preload.mjs --import tsx --test tests/auth.test.ts tests/phase3.test.ts tests/phase4.test.ts tests/phase5.test.ts tests/timetable-import.test.ts tests/fixture-rules.test.ts tests/performance.test.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:seed": "node --import ./tests/tsx-windows-preload.mjs --import tsx prisma/seed.ts",
    "timetable:parse": "node --import ./tests/tsx-windows-preload.mjs --import tsx scripts/parse-official-timetable.ts",
    "timetable:import": "node --import ./tests/tsx-windows-preload.mjs --import tsx scripts/import-official-timetable.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "node --import ./tests/tsx-windows-preload.mjs --import tsx prisma/seed.ts"
  }
}
